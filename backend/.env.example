# MongoDB Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your-secure-password-here

# Database Configuration
MONGODB_URL=mongodb://localhost:38017
DATABASE_NAME=hive_platform

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration (Update with your production domains)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend API URL (Update with your production backend URL)
VITE_API_URL=http://localhost:8000

# App Configuration
APP_NAME=The Hive Platform
DEBUG=true

# Email / SMTP (leave blank to disable email sending)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com
MAIL_STARTTLS=true

# Frontend URL (used in email verification links)
FRONTEND_URL=http://localhost:3000
